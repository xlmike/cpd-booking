@{
    ViewData["Title"] = "Accessibility statement";
}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Accessibility statement</h1>
    <p class="govuk-body">This practice service aims to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA.</p>
    <p class="govuk-body">You should be able to:</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>use the service with a keyboard only</li>
      <li>use the service with a screen reader</li>
      <li>zoom in up to 400% without the text spilling off the screen</li>
      <li>use the service without JavaScript</li>
    </ul>
    <h2 class="govuk-heading-m">How we test this service</h2>
    <p class="govuk-body">Every pull request runs automated accessibility checks with axe. We also test manually with a keyboard and with NVDA and VoiceOver before each release.</p>
  </div>
</div>
