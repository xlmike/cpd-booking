@* GOV.UK error summary: shown at the top of the page, each error links to its field.
   The govuk-error-summary module moves focus here so screen reader users hear the errors. *@
@if (!ViewData.ModelState.IsValid)
{
  <div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <ul class="govuk-list govuk-error-summary__list">
          @foreach (var entry in ViewData.ModelState.Where(e => e.Value is { Errors.Count: > 0 }))
          {
            foreach (var error in entry.Value!.Errors)
            {
              <li><a href="#@entry.Key">@error.ErrorMessage</a></li>
            }
          }
        </ul>
      </div>
    </div>
  </div>
}
