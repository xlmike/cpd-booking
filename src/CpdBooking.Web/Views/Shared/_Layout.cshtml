<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
  <meta charset="utf-8">
  <title>@ViewData["Title"] – Book a teacher training course</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1d70b8">
  <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
</head>
<body class="govuk-template__body">
  @* Adds the js-enabled class. An external file, because the Content Security Policy blocks inline scripts. *@
  <script src="~/js/govuk-init.js" asp-append-version="true"></script>

  <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

  @* This practice project must not use the GOV.UK crown or GDS Transport font: they are only for GOV.UK services. *@
  <header class="app-header">
    <section aria-label="Service information" class="govuk-service-navigation" data-module="govuk-service-navigation">
      <div class="govuk-width-container">
        <div class="govuk-service-navigation__container">
          <span class="govuk-service-navigation__service-name">
            <a href="/" class="govuk-service-navigation__link">Book a teacher training course</a>
          </span>
        </div>
      </div>
    </section>
  </header>

  <div class="govuk-width-container">
    <div class="govuk-phase-banner">
      <p class="govuk-phase-banner__content">
        <strong class="govuk-tag govuk-phase-banner__content__tag">Practice</strong>
        <span class="govuk-phase-banner__text">This is a practice project, not a real government service.</span>
      </p>
    </div>

    @await RenderSectionAsync("BeforeContent", required: false)

    <main class="govuk-main-wrapper" id="main-content">
      @RenderBody()
    </main>
  </div>

  <footer class="govuk-footer">
    <div class="govuk-width-container">
      <div class="govuk-footer__meta">
        <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
          <h2 class="govuk-visually-hidden">Support links</h2>
          <ul class="govuk-footer__inline-list">
            <li class="govuk-footer__inline-list-item">
              <a class="govuk-footer__link" href="/accessibility">Accessibility statement</a>
            </li>
            <li class="govuk-footer__inline-list-item">
              <a class="govuk-footer__link" href="/api/v1/courses">API</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </footer>

  <script type="module" src="~/js/app.mjs" asp-append-version="true"></script>
</body>
</html>
